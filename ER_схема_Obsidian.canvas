		{"id":"edge_appointment_appointment_diagnosis","fromNode":"table_appointment","fromSide":"bottom","toNode":"table_appointment_diagnosis","toSide":"top","label":"1 → N"},
		{"id":"edge_diagnosis_appointment_diagnosis","fromNode":"table_diagnosis","fromSide":"right","toNode":"table_appointment_diagnosis","toSide":"left","label":"1 → N"},
		{"id":"edge_appointment_prescription","fromNode":"table_appointment","fromSide":"right","toNode":"table_prescription","toSide":"top","label":"1 → N"}
